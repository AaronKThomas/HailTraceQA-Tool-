PORT=3001
NODE_ENV=development
SESSION_SECRET=replace_with_a_long_random_secret
# Comma-separated origins allowed to call the backend with session cookies.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# In production, leave this false unless you intentionally want mock/demo behavior.
ALLOW_DEMO_MODE=true

# Copy this file to .env and fill in the values you have.
# Restart the backend after changes: npm run server
#
# Each integration turns on automatically when its variables are set.
# Leave a group empty to keep using demo mode for that feature.

# --- HailTrace QA API (run-test) ---
HAILTRACE_API_BASE_URL=https://api.hailtrace.com
HAILTRACE_API_KEY=your_hailtrace_api_key
# Path appended to base URL (adjust to match your API)
HAILTRACE_QA_PATH=/qa/run-test
# bearer | api-key
HAILTRACE_AUTH_STYLE=bearer

# --- Jira (ticket import) ---
JIRA_BASE_URL=https://yourcompany.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your_jira_api_token

# --- Slack (notifications) ---
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/path

# --- Zoho Cliq (notifications) ---
ZOHO_CLIQ_WEBHOOK_URL=https://cliq.zoho.com/api/v2/channelsbyname/your-channel/message?zapikey=your_zapikey

# --- OpenAI / ChatGPT (interpret plain English, then call HailTrace when configured) ---
OPENAI_API_KEY=your_openai_api_key
# Optional: gpt-4o, gpt-4o-mini, etc.
OPENAI_MODEL=gpt-4o-mini
# For full pipeline (interpret → execute → summarize), set OpenAI + HailTrace keys above.
