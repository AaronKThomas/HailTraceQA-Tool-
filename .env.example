# Local development template. Copy to .env (gitignored) and fill in real values.
#   cp .env.example .env
# Restart the backend after changes: npm run start:dev
#
# Each integration turns on automatically when its variables are set.
# Leave a group empty to keep using demo mode for that feature.
#
# IMPORTANT: Do NOT set NODE_ENV in this file. Leaving it unset means the
# backend runs in development mode and falls back to safe localhost CORS
# defaults. For production, use a separate .env.production file — see
# .env.production.example and QUICKSTART.md section 7.

PORT=3001
ALLOW_DEMO_MODE=true

# Allow /run-test callers to supply a pre-built browser action plan in the
# request body (bypasses the LLM and runs Playwright directly). Handy for local
# testing; denied by default in production to limit abuse of shared target-site
# credentials. Defaults: true in dev, false in production.
# ALLOW_CLIENT_ACTION_PLANS=true

# --- Test video replays ---
# Records a short Playwright .webm replay for each browser run and serves it
# only through authenticated backend artifact routes. Disable if a target page
# may expose data that should never be retained on disk.
TEST_REPLAY_RECORDING=true
TEST_REPLAY_RETENTION_DAYS=7

# Set to true ONLY when the app runs behind a trusted reverse proxy / load
# balancer that sets X-Forwarded-For. When false (the default), that header is
# ignored for rate limiting so clients cannot spoof it to bypass limits.
# TRUST_PROXY=false

# --- App public URL (used to build invite + reset links in emails) ---
# In dev, this is your Vite origin. Update for production deploys.
APP_PUBLIC_URL=http://localhost:5173

# --- Customer.io transactional email ---
# Leave blank in dev to use the in-console "demo" fallback that logs invite
# and reset links to the server output. With a real key, real emails will
# send.
CUSTOMERIO_APP_API_KEY=
CUSTOMERIO_REGION=us
CUSTOMERIO_FROM_NAME=HailTrace QA
CUSTOMERIO_INVITE_TEMPLATE_ID=
CUSTOMERIO_RESET_TEMPLATE_ID=

# --- Jira (ticket import) ---
JIRA_BASE_URL=https://yourcompany.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your_jira_api_token

# --- Slack (notifications) ---
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/path

# --- Zoho Cliq (notifications) ---
ZOHO_CLIQ_WEBHOOK_URL=https://cliq.zoho.com/api/v2/channelsbyname/your-channel/message?zapikey=your_zapikey

# --- LLM provider (interpret plain English, then summarize Playwright results) ---
# Any OpenAI-compatible /v1/chat/completions endpoint works. Two common setups:
#
# 1) OpenAI (hosted, paid): set a real key and a hosted model.
#      OPENAI_API_KEY=sk-...
#      OPENAI_MODEL=gpt-4o-mini
#
# 2) Local Ollama (free, no key): run a model on your machine and point the
#    base URL at it. Leave OPENAI_API_KEY blank — local servers need no key.
#      Install: https://ollama.com  then:  ollama pull llama3.1
#      OPENAI_BASE_URL=http://localhost:11434/v1
#      OPENAI_MODEL=llama3.1
#
# The pipeline turns on when either OPENAI_API_KEY or a non-default
# OPENAI_BASE_URL is set. Otherwise the app falls back to a direct Playwright
# check (URL in the request) or demo mode.
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
# Override only to use a non-OpenAI, OpenAI-compatible endpoint (e.g. Ollama).
# Default: https://api.openai.com/v1
# OPENAI_BASE_URL=http://localhost:11434/v1

# --- Target website auth for Playwright page actions ---
# Server-side only. Use a dedicated low-privilege test account, never a human
# admin login. The runner logs in through the target site's own login form.
# Default HailTrace page used when a QA prompt does not include a URL.
TARGET_SITE_DEFAULT_URL=https://app.hailtrace.com/maps
TARGET_SITE_LOGIN_URL=https://app.hailtrace.com/login
TARGET_SITE_TEST_EMAIL=your_low_privilege_test_account@example.com
TARGET_SITE_TEST_PASSWORD=your_low_privilege_test_password
# Field detection is automatic for common login forms (matches input type,
# name, placeholder, or label). Override only if auto-detection fails.
# Submit button text (default "Log In"):
TARGET_SITE_SUBMIT_NAME=Log In
# Optional CSS selector overrides for non-standard forms:
# TARGET_SITE_EMAIL_SELECTOR=input[name="email"]
# TARGET_SITE_PASSWORD_SELECTOR=input[name="password"]
# TARGET_SITE_SUBMIT_SELECTOR=button[type="submit"]
# Optional selector that only appears AFTER a successful login (e.g. a user
# menu or dashboard element). When set it is the authoritative success signal;
# otherwise the runner confirms login by detecting that the login page was left.
# TARGET_SITE_LOGGED_IN_SELECTOR=[data-testid="user-menu"]
